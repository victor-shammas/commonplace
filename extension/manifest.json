{
  "manifest_version": 3,
  "key": "",
  "name": "Commonplace",
  "version": "1.1",
  "description": "Save pages to a running log in Apple Notes.",
  "permissions": ["activeTab", "nativeMessaging", "storage", "scripting"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
